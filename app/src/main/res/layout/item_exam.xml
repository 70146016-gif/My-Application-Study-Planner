<?xml version="1.0" encoding="utf-8"?>
<!-- ONE row in the Exams list (also used on Home) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExamSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="SPM" />

        <TextView
            android:id="@+id/tvExamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            tools:text="25 Oct 2026" />

        <TextView
            android:id="@+id/tvExamNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textStyle="italic"
            tools:text="Mid-term, chapters 1–4" />
    </LinearLayout>

    <!-- "3 days left" label -->
    <TextView
        android:id="@+id/tvDaysLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/pending_orange"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="3 days left" />

    <ImageButton
        android:id="@+id/btnDeleteExam"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete exam"
        android:src="@android:drawable/ic_menu_delete" />
</LinearLayout>
